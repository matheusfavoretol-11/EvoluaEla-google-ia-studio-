{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|auth|logo.png|favicon.ico|assets).*)",
      "destination": "/index.html"
    }
  ]
}
