# GEMINI_API_KEY: Necessária para as funções de IA (Coach e Diário).
GEMINI_API_KEY=""

# APP_URL: A URL base do seu app (usada para redirecionamentos da Stripe).
# Se estiver no AI Studio, use a 'Shared App URL' que aparece no topo do chat.
# Exemplo: https://ais-pre-l36vjwcu5ypvyxdbggdsnn-258060382701.us-west2.run.app
APP_URL=""

# IMPORTANTE: Você também precisa rodar o script SQL no Supabase!
# Abra o arquivo SUPABASE_SETUP.sql no editor de código, copie o conteúdo
# e cole no 'SQL Editor' do seu painel do Supabase para criar as tabelas.

# Supabase Credentials (Frontend)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Service Role Key (Backend)
# IMPORTANTE: Pegue em Project Settings > API > service_role (secret)
# Usada para atualizar o status de Premium automaticamente após o pagamento.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe Keys (Backend)
# Pegue no painel da Stripe em Developers > API keys
STRIPE_SECRET_KEY=""

# Stripe Webhook Secret (Backend)
# Pegue no painel da Stripe em Developers > Webhooks após configurar a URL
# URL do Webhook: https://ais-pre-l36vjwcu5ypvyxdbggdsnn-258060382701.us-west2.run.app/api/webhook
STRIPE_WEBHOOK_SECRET=""

# Zoom API Credentials (Backend)
# Pegue no Zoom App Marketplace (Server-to-Server OAuth)
# https://marketplace.zoom.us/
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_ACCOUNT_ID=""
